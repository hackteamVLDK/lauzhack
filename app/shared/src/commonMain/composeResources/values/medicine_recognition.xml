    <string name="rec_search">Search the registries</string>
    <string name="rec_intro">Photograph the box, bottle label, sachet or the foil side of the blister. A barcode helps but is not needed.</string>
    <string name="rec_privacy">The code and locally read package text are sent to the Easy Paper server to search the registries. A photo is sent only if you choose online reading.</string>
